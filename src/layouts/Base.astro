---
import { getSiteSettings } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import DevHubSearch from "../components/DevHubSearch";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import "../styles/global.css";

interface Props {
  title: string;
  pageTitle?: string | null;
  description?: string | null;
  image?: string | null;
  canonical?: string | null;
  content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, content } =
  Astro.props;

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(
  await getSiteSettings(),
);

const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;

const pageDescription = description ?? siteTagline;

const pageCtx = createPublicPageContext({
  Astro,
  kind: content ? "content" : "custom",
  pageType: "website",
  title: fullTitle,
  pageTitle: pageTitle ?? title,
  description: pageDescription,
  canonical,
  image,
  content,
  siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>

    {pageDescription && <meta name="description" content={pageDescription} />}

    {canonical && <link rel="canonical" href={canonical} />}

    <EmDashHead page={pageCtx} />
  </head>

  <body>
    <EmDashBodyStart page={pageCtx} />

    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">
          {siteLogo ? (
            <img src={siteLogo.url} alt={siteLogo.alt || siteTitle} />
          ) : (
            <span class="brand-mark">D</span>
          )}

          <span class="brand-name">{siteTitle}</span>
        </a>

        <nav class="site-nav" aria-label="Primary navigation">
          <a href="/api/explorer" class="nav-api-explorer">API Explorer</a>
          <a href="/docs">Docs</a>
          <a href="/guides">Guides</a>
          <a href="/changelog">Changelog</a>
          <a href="/resources">Resources</a>
        </nav>

        <div class="header-search">
          <DevHubSearch placeholder="Search documentation..." client:load />
        </div>
      </div>
    </header>
    <details class="mobile-docs-menu">
      <summary>Documentation menu</summary>

      <nav class="mobile-docs-nav" aria-label="Documentation navigation">
        <div class="sidebar-section">
          <p class="sidebar-heading">Documentation</p>
          <a href="/getting-started">Getting Started</a>
          <a href="/authentication">Authentication</a>
        </div>

        <div class="sidebar-section">
          <p class="sidebar-heading">API Reference</p>
          <a href="/api/projects">Projects API</a>
          <a href="/api/users">Users API</a>
          <a href="/api/webhooks">Webhooks</a>
          <a href="/api/explorer">API Explorer</a>
        </div>

        <div class="sidebar-section">
          <p class="sidebar-heading">Guides</p>
          <a href="/guides/error-handling">Error Handling</a>
          <a href="/guides/webhooks">Webhooks</a>
        </div>

        <div class="sidebar-section">
          <p class="sidebar-heading">Resources</p>
          <a href="/resources">Resources</a>
        </div>
      </nav>
    </details>
    <div class="portal-layout">
      <aside class="docs-sidebar">
        <div class="sidebar-section">
          <p class="sidebar-heading">Documentation</p>

          <a href="/getting-started">Getting Started</a>

          <a href="/authentication">Authentication</a>
        </div>

        <div class="sidebar-section">
          <p class="sidebar-heading">API Reference</p>

          <a href="/api/explorer">API Explorer</a>
          <a href="/api/projects">Projects</a>
          <a href="/api/users">Users</a>
          <a href="/api/webhooks">Webhooks</a>
        </div>

        <div class="sidebar-section">
          <p class="sidebar-heading">Guides</p>

          <a href="/guides/error-handling">Error Handling</a>

          <a href="/guides/webhooks">Working with Webhooks</a>
        </div>

        <div class="sidebar-section">
          <p class="sidebar-heading">Resources</p>

          <a href="/resources">Resources</a>
        </div>
      </aside>

      <main class="main-content">
        <div class="content-container">
          <slot />
        </div>
      </main>
    </div>

    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <strong>{siteTitle}</strong>
          <p>{siteTagline}</p>
        </div>

        <div class="footer-links">
          <a href="/api/explorer">API Explorer</a>
          <a href="/docs">Documentation</a>
          <a href="/api">API Reference</a>
          <a href="/guides">Guides</a>
          <a href="/posts">Changelog</a>
        </div>
      </div>
    </footer>

    <EmDashBodyEnd page={pageCtx} />
  </body>
</html>
